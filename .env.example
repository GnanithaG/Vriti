# ---- Required ----
# Password you type to open the app. Make it long.
APP_PASSWORD=
# Any long random string (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=
# From console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ---- Job search (set at least one) ----
# RapidAPI → JSearch → subscribe → copy "X-RapidAPI-Key"
JSEARCH_API_KEY=
# JSearch requests per search run (3 runs/day). 3 → ~270/month.
JSEARCH_QUERIES_PER_RUN=3
# developer.adzuna.com → Dashboard → App ID and Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Database ----
# Railway fills this in when you add a Postgres database. Leave as-is locally to use SQLite.
DATABASE_URL=sqlite:///./data/upajna.db

# ---- Applying ----
# Start with false: forms are filled but NOT submitted, and you see a screenshot.
# After a few look right, change to true so approved applications are submitted.
APPLY_SUBMIT=false

# ---- Notifications (run: python scripts/gen_vapid.py) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Optional ----
TZ_NAME=America/Los_Angeles
# minute hour day month weekday, in TZ_NAME. Default 11am, 3pm, 7pm.
SEARCH_CRON=0 11,15,19 * * *
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_QUICK_MODEL=claude-haiku-4-5-20251001
