# Copy this file to .env and fill in your keys. Never commit .env.

# Required for Phase 4 (AI-assisted resume tailoring).
ANTHROPIC_API_KEY=

# Signs session cookies (Phase 1 accounts & auth). If left blank, Vriti
# generates a random one on first run and saves it back to this file —
# set your own if you want sessions to survive deleting this file.
SECRET_KEY=
